# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

output/

# Benchmark fixtures regenerated by scripts/export_ddr_sandbox.py against ~/projects/ddr.
# Not source — regenerate with `uv run python scripts/export_ddr_sandbox.py`.
# Only ignore root-level and examples-level fixtures/ — tests/fixtures/ is tracked source.
# Exceptions that stay tracked: fixtures/sandbox/ (src/sandbox.rs embeds it
# at compile time via include_str!; tests/ddr_sandbox_match.rs documents it
# as committed: "a missing file means a broken checkout, not a skippable
# test") and fixtures/gradcheck/ (32 KB from scripts/dump_solver_gradcheck.py;
# without it tests/sparse_gradcheck.rs, the DDR-parity gate for the sparse
# backward, self-skips and CI would never run it). fixtures/sp4 and
# fixtures/sp5 predate this rule and are already tracked.
/fixtures/*
!/fixtures/sandbox/
!/fixtures/gradcheck/
examples/fixtures/

# Agent notes are tracked (ARCHITECTURE.md, skills/, specs/) — only ignore transient state
.claude/worktrees/
.claude/**/.regenerate-state.json
.claude/settings.local.json

# Throwaway BURN API exploration directory
spike_backward/

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python bytecode cache from scripts/*.py run under DDR's uv venv
__pycache__/

.cargo/
.ddrs/
.ddrs-synthetic-n-*/
ddrs.yaml
# …but the Juniata sample's config is a committed example, not a personal
# workspace config (its .ddrs/ workspace is still ignored by the rule above).
!examples/juniata/ddrs.yaml

# Personal research journal (local only)
JOURNAL.md
